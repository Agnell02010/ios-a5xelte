+		/* UFSHCD_QUIRK_USE_OF_HCE: S-Boot leaves HCE=0 while HCS is ready. */
 		printf("GREATLTE UFS: A host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
 		return ENXIO;
 	}
@@ -838,7 +839,7 @@ ufs_tur(void)
  * HCE cycle, as ufshcd_link_startup() does.
  */
 static int
-ufs_bring_up_link(void)
+ufs_restart_link(void)
 {
 	int error = ENXIO, ls = EIO;
 
@@ -920,6 +921,39 @@ ufs_bring_up_link(void)
 	}
 	return error;
 }
+
+/*
+ * Reuse the UFS link that Samsung S-Boot used to load BOOT. The Galaxy S8
+ * Exynos 8895 reference driver/probe confirms that this host is live with
+ * HCS=0xf even though HCE reads zero. Reinitializing HCE, PHY or DME link
+ * startup discards that known-good link state; opt into the old experimental
+ * path only with ufslinkrestart=1.
+ */
+static int
+ufs_bring_up_link(void)
+{
+	uint32_t restart = 0;
+	PE_parse_boot_argn("ufslinkrestart", &restart, sizeof(restart));
+	if (restart == 1) {
+		return ufs_restart_link();
+	}
+
+	printf("GREATLTE UFS: reusing S-Boot link hce 0x%x hcs 0x%x dbr 0x%x\n",
+	    ufs_rd(REG_HCE), ufs_rd(REG_HCS), ufs_rd(REG_UTRLDBR));
+	int error = ufs_take_over_host(false);
+	if (error) {
+		printf("GREATLTE UFS: S-Boot host takeover failed %d\n", error);
+		return error;
+	}
+	error = ufs_wake_device();
+	printf("GREATLTE UFS: S-Boot link device wake %d\n", error);
+	if (!error) {
+		error = ufs_tur();
+		printf("GREATLTE UFS: S-Boot link LUN0 TUR %d\n", error);
+	}
+	return error;
+}
