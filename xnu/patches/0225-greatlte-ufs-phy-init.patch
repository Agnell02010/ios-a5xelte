+/*
+ * MPHY PMA writes need the APB clock ungated. The vendor driver clears
+ * MPHY_APBCLK_STOP around each access and restores the previous value (with
+ * the stop bit set).
+ */
+static void
+ufs_phy_pma_wr(uint32_t off, uint32_t val)
+{
+	uint32_t stop = ufs_rd(VS_CLKSTOP_CTRL);
+
+	ufs_wr(VS_CLKSTOP_CTRL, stop & ~VS_MPHY_APBCLK_STOP);
+	__builtin_arm_dsb(0xf);
+	ufs_wr(PHY_PMA_OFF + off, val);
+	__builtin_arm_dsb(0xf);
+	ufs_wr(VS_CLKSTOP_CTRL, stop | VS_MPHY_APBCLK_STOP);
+}
