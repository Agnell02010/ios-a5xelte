+/*
+ * PRE_CHANGE half of the vendor's link_startup_notify: ungate the PHY and
+ * UniPro clocks, select the alternative MPHY reference clock and disable
+ * HWACG, then apply the DTS phy-init table.
+ */
+static void
+ufs_pre_link_setup(void)
+{
+	uint32_t v;
+
+	v = ufs_rd(VS_FORCE_HCS);
+	ufs_wr(VS_FORCE_HCS, v | VS_FORCE_CLK_STOP_ALL);
+	v = ufs_rd(VS_MPHY_REFCLK_SEL);
+	ufs_wr(VS_MPHY_REFCLK_SEL, v | VS_REFCLK_ALT);
+	v = ufs_rd(VS_CLKSTOP_CTRL);
+	ufs_wr(VS_CLKSTOP_CTRL, v & ~VS_CLKSTOP_ALL);
+	v = ufs_rd(VS_ACG_DISABLE);
+	ufs_wr(VS_ACG_DISABLE, v | VS_ACG_DISABLE_EN);
+	__builtin_arm_dsb(0xf);
+}
