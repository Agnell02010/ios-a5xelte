+static void
+ufs_phy_table(const struct phy_cfg *cfg, unsigned n, const char *name)
+{
+	unsigned ok = 0, bad = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		int error = 0;
+		switch (cfg[i].kind) {
+		case PHY_CFG_DME:
+			error = ufs_uic_cmd(UIC_DME_SET, cfg[i].addr << 16, 0,
+			    cfg[i].val, true);
+			break;
+		case PHY_CFG_DME_RX:
+			for (unsigned lane = 0; lane < 2; lane++) {
+				error |= ufs_uic_cmd(UIC_DME_SET,
+				    (cfg[i].addr << 16) | (4 + lane), 0,
+				    cfg[i].val, true);
+			}
+			break;
+		case PHY_CFG_DME_TX:
+			for (unsigned lane = 0; lane < 2; lane++) {
+				error |= ufs_uic_cmd(UIC_DME_SET,
+				    (cfg[i].addr << 16) | lane, 0,
+				    cfg[i].val, true);
+			}
+			break;
+		case PHY_CFG_PMA_COMN:
+			ufs_phy_pma_wr(PHY_PMA_COMN(cfg[i].addr), cfg[i].val);
+			break;
+		case PHY_CFG_PMA_TRSV:
+			for (unsigned lane = 0; lane < 2; lane++) {
+				ufs_phy_pma_wr(PHY_PMA_TRSV(cfg[i].addr, lane),
+				    cfg[i].val);
+			}
+			break;
+		case PHY_CFG_WAIT:
+			delay(cfg[i].val);
+			break;
+		}
+		if (error) {
+			bad++;
+		} else {
+			ok++;
+		}
+	}
+	printf("GREATLTE UFS: %s %u ok %u err\n", name, ok, bad);
+}
