 			return ETIMEDOUT;
 		}
 		if (sleepable && now >= spin_until) {
@@ -811,7 +811,8 @@ ufs_take_over_host(bool enable_hce)
 		if (ufs_hce_start() != 0) {
 			return ENXIO;
