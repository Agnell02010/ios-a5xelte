--- a/bsd/dev/greatlte_ufs.c
+++ b/bsd/dev/greatlte_ufs.c
@@ -228,8 +228,8 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	ucd->cmd[15] = (uint8_t)len;
