+/*
+ * Bring the link and the device up. A reuses S-Boot's controller state; B
+ * enables the controller the way the vendor driver does. The device may also
+ * need START STOP UNIT (ACTIVE) after the bootloader, so wake it before giving
+ * up on each path.
+ */
+static int
+ufs_bring_up_link(void)
+{
+	int error = ENXIO, ls;
+
+	printf("GREATLTE UFS: dma 0x%llx\n", su.dma_pa);
+
+	/* A: reuse the bootloader state without writing HCE. */
+	if (ufs_take_over_host(false) == 0) {
+		error = ufs_tur();
+		printf("GREATLTE UFS: A lun0 TUR %d\n", error);
+		if (error) {
+			printf("GREATLTE UFS: waking the device\n");
+			(void)ufs_wake_device();
+			error = ufs_tur();
+			printf("GREATLTE UFS: A lun0 TUR after wake %d\n", error);
+		}
+		if (error) {
+			ls = ufs_uic_cmd(UIC_DME_LINK_STARTUP);
+			printf("GREATLTE UFS: A link startup %d\n", ls);
+			if (ls == 0) {
+				error = ufs_tur();
+				printf("GREATLTE UFS: A lun0 TUR after link %d\n", error);
+			}
+		}
+	} else {
+		printf("GREATLTE UFS: A takeover failed\n");
 	}
-	return 0;
+
+	/* B: enable the controller the way the vendor driver does. */
+	if (error) {
+		if (ufs_take_over_host(true) == 0) {
+			ls = ufs_uic_cmd(UIC_DME_LINK_STARTUP);
+			printf("GREATLTE UFS: B link startup %d\n", ls);
+			printf("GREATLTE UFS: waking the device\n");
+			(void)ufs_wake_device();
+			error = ufs_tur();
+			printf("GREATLTE UFS: B lun0 TUR %d\n", error);
+		} else {
+			printf("GREATLTE UFS: B takeover failed\n");
+		}
+	}
+	return error;
 }
 
