+static int
+ufs_uic_cmd(uint32_t cmd)
+{
+	ufs_wr(REG_IE, 0);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UIC_ARG1, 0);
+	ufs_wr(REG_UIC_ARG2, 0);
+	ufs_wr(REG_UIC_ARG3, 0);
+	ufs_wr(REG_UIC_CMD, cmd);
+	uint32_t is = 0;
+	for (int i = 0; i < 500; i++) {
+		is = ufs_rd(REG_IS);
+		if (is & (IS_UIC_COMPL | IS_UIC_ERROR)) {
+			break;
+		}
+		delay(1);
+	}
+	uint32_t a2 = ufs_rd(REG_UIC_ARG2), a3 = ufs_rd(REG_UIC_ARG3);
+	printf("GREATLTE UFS: UIC cmd 0x%x is 0x%x arg2 0x%x arg3 0x%x\n", cmd, is, a2, a3);
+	ufs_wr(REG_IS, is);
+	if (!(is & IS_UIC_COMPL) || (a2 & 0xff) != 0) {
+		return EIO;
+	}
+	return 0;
+}
