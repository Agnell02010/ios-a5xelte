+	/* Exynos CT=1 is a UFS storage command; DD: 1 = out, 2 = in. */
+	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
 	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
 	utrd->ucdba = (uint32_t)ucd_pa;
 	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
@@ -306,7 +306,7 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 			    ufs_rd(REG_UIC_ERR_PA), ufs_rd(REG_UIC_ERR_DL),
 			    ufs_rd(REG_UIC_ERR_N), ufs_rd(REG_UIC_ERR_T),
 			    ufs_rd(REG_UIC_ERR_DME));
-			ufs_wr(REG_UTRLCLR, 1u);   /* BROKEN_REQ_LIST_CLR */
