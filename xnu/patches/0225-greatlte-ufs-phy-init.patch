-ufs_uic_cmd(uint32_t cmd)
+ufs_uic_cmd(uint32_t cmd, uint32_t arg1, uint32_t arg2, uint32_t arg3, bool quiet)
 {
+	uint32_t is = 0;
+
+	/* The controller accepts a UIC command only while HCS.UCRDY is set. */
+	for (int i = 0; i < 100 && !(ufs_rd(REG_HCS) & HCS_UCRDY); i++) {
+		delay(1000);
+	}
+	ufs_wr(REG_IE, 0);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UIC_ARG1, arg1);
+	ufs_wr(REG_UIC_ARG2, arg2);
+	ufs_wr(REG_UIC_ARG3, arg3);
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_UIC_CMD, cmd);
+
+	for (int i = 0; i < 500; i++) {
+		is = ufs_rd(REG_IS);
+		if (is & IS_UIC_COMPL) {
+			break;
+		}
+		/*
+		 * Link startup may report UIC_ERROR first and still complete;
+		 * keep waiting so ARG2/the completion bit can arrive. Other
+		 * commands fail fast.
+		 */
+		if ((is & IS_UIC_ERROR) && cmd != UIC_DME_LINK_STARTUP) {
+			break;
+		}
+		delay(1000);
+	}
+	uint32_t a2 = ufs_rd(REG_UIC_ARG2), a3 = ufs_rd(REG_UIC_ARG3);
+	int result = (is & IS_UIC_COMPL) ? (int)(a2 & UIC_RESULT_MASK) : -1;
+
+	if (!quiet || result != 0 || !(is & IS_UIC_COMPL)) {
+		printf("GREATLTE UFS: uic 0x%x arg 0x%x is 0x%x a2 0x%x a3 0x%x res %d\n",
+		    cmd, arg1, is, a2, a3, result);
+		if (is & (IS_UIC_ERROR | IS_UIC_COMPL)) {
+			printf("GREATLTE UFS: uic err pa 0x%x dl 0x%x n 0x%x t 0x%x dme 0x%x lsreq 0x%x lscnf 0x%x\n",
+			    ufs_rd(REG_UIC_ERR_PA), ufs_rd(REG_UIC_ERR_DL),
+			    ufs_rd(REG_UIC_ERR_N), ufs_rd(REG_UIC_ERR_T),
+			    ufs_rd(REG_UIC_ERR_DME),
+			    unipro_rd(UNIPRO_LINKSTARTUP_REQ),
+			    unipro_rd(UNIPRO_LINKSTARTUP_CNF));
+		}
+	}
+	if (!(is & IS_UIC_COMPL)) {
