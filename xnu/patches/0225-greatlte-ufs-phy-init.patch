+/*
+ * Bring the link and the device up. S-Boot leaves HCE off on the 8895, so the
+ * controller is enabled the way the vendor driver does, then the MPHY/UniPro
+ * tables run before DME_LINK_STARTUP. Link startup is retried with a fresh
+ * HCE cycle, as ufshcd_link_startup() does.
+ */
+static int
+ufs_bring_up_link(void)
+{
+	int error = ENXIO, ls = EIO;
+
+	printf("GREATLTE UFS: dma 0x%llx clkstop 0x%x force 0x%x acg 0x%x refclk 0x%x\n",
+	    su.dma_pa, ufs_rd(VS_CLKSTOP_CTRL), ufs_rd(VS_FORCE_HCS),
+	    ufs_rd(VS_ACG_DISABLE), ufs_rd(VS_MPHY_REFCLK_SEL));
+
+	if (ufs_take_over_host(true) != 0) {
+		printf("GREATLTE UFS: takeover failed\n");
+		return ENXIO;
+	}
+
+	for (int attempt = 0; attempt < 3; attempt++) {
+		if (attempt) {
+			int i;
+
+			printf("GREATLTE UFS: link retry %d\n", attempt + 1);
+			ufs_wr(REG_HCE, 0);
+			for (i = 0; i < 20 && (ufs_rd(REG_HCE) & 1); i++) {
+				delay(1000);
+			}
+			delay(5000);
+			ufs_wr(REG_HCE, 1);
+			for (i = 0; i < 100 && !(ufs_rd(REG_HCE) & 1); i++) {
+				delay(1000);
+			}
+			for (i = 0; i < 100 && !(ufs_rd(REG_HCS) & HCS_UCRDY); i++) {
+				delay(1000);
+			}
+			if (ufs_program_list() != 0) {
+				break;
+			}
+		}
+
+		ufs_pre_link_setup();
+		ufs_phy_table(greatlte_phy_init,
+		    sizeof(greatlte_phy_init) / sizeof(greatlte_phy_init[0]),
+		    "phy init");
+		ls = ufs_uic_cmd(UIC_DME_LINK_STARTUP, 0, 0, 0, false);
+		printf("GREATLTE UFS: link startup %d (try %d)\n", ls, attempt + 1);
+		if (ls) {
+			continue;
+		}
+
+		ufs_phy_table(greatlte_post_phy_init,
+		    sizeof(greatlte_post_phy_init) / sizeof(greatlte_post_phy_init[0]),
+		    "post phy");
+		error = ufs_tur();
+		printf("GREATLTE UFS: lun0 TUR %d\n", error);
+		if (error) {
+			printf("GREATLTE UFS: waking the device\n");
+			(void)ufs_wake_device();
+			error = ufs_tur();
+			printf("GREATLTE UFS: lun0 TUR after wake %d\n", error);
+		}
+		break;
+	}
+	if (error) {
+		printf("GREATLTE UFS: bring-up failed (link %d)\n", ls);
+	}
+	return error;
+}
 
