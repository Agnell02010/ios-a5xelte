+/* Samsung sec_ts sends the command, then reads the reply in a second message. */
+static bool
+great_ts_xfer(const uint8_t *w, unsigned wlen, uint8_t *r, unsigned rlen)
+{
+	if ((!wlen && !rlen) || wlen > 32u || rlen > 248u) {
+		return false;
+	}
+	if (wlen && !great_ts_message(false, (uint8_t *)w, wlen)) {
+		return false;
+	}
+	return !rlen || great_ts_message(true, r, rlen);
