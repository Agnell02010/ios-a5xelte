+/* S2MPS17 is reached through Exynos SPEEDY, slave 1.  The Samsung Note8
+ * device tree names LDO34 (1.85 V) tsp_io and LDO35 (3.3 V) tsp_avdd.
+ * The stock Y661 driver enables IO, waits 1 ms, then enables AVDD. */
+static int
+great_ts_speedy(unsigned reg, bool write, uint8_t val)
+{
+	vm_offset_t b = great_ts_speedy;
+	const uint32_t cmd = (1u << 19) | (write ? (1u << 20) : 0) |
+	    (1u << 15) | ((reg & 0xffu) << 7);
+
+	great_ts_write(b, 0x004, 1u << 31);
+	delay(10);
+	great_ts_write(b, 0x004, 0x101u);
+	great_ts_write(b, 0x00c, write ? 0x80300011u : 0x80070301u);
+	great_ts_write(b, 0x010, 0xffffffffu);
+	great_ts_write(b, 0x008, cmd);
+	if (write) {
+		great_ts_write(b, 0x034, val);
+	}
+	for (unsigned us = 0; us < 10000u; us++) {
+		if (great_ts_read(b, 0x010) & 1u) {
+			great_ts_write(b, 0x010, 0xffffffffu);
+			return write ? 0 : (int)(great_ts_read(b, 0x038) & 0xffu);
+		}
+		delay(1);
+	}
+	return -1;
+}
+
+static bool
+great_ts_power_on(void)
+{
+	/* LDO34: 0xc0 enable + (1.85 V - 0.70 V) / 25 mV = 0xee.
+	 * LDO35: 0xc0 enable + (3.30 V - 1.80 V) / 25 mV = 0xfc. */
+	int before34 = great_ts_speedy(0x5f, false, 0);
+	int before35 = great_ts_speedy(0x60, false, 0);
+	int r34 = great_ts_speedy(0x5f, true, 0xee);
+	great_ts_wait(1);
+	int r35 = great_ts_speedy(0x60, true, 0xfc);
+	great_ts_wait(20);
+	int after34 = great_ts_speedy(0x5f, false, 0);
+	int after35 = great_ts_speedy(0x60, false, 0);
+	printf("GREATLTE TOUCH: PMIC L34 %x>%x rc=%d L35 %x>%x rc=%d\n",
+	    before34, after34, r34, before35, after35, r35);
+	return r34 == 0 && r35 == 0 && after34 == 0xee && after35 == 0xfc;
+}
